// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  HR_ADMIN
  HIRING_MANAGER
  LINE_MANAGER
  EMPLOYEE
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  role                Role                 @default(EMPLOYEE)
  employee            Employee?            @relation("UserEmployee")
  jobEvaluations      JobEvaluation[]
  criticalAssessments CriticalAssessment[]
  compensationRecords CompensationRecord[]
  bankTransferExports BankTransferExport[]
  createdAt           DateTime             @default(now())
}

enum EmploymentStatus {
  ACTIVE
  RESIGNED
}

enum ContractType {
  PERMANENT
  FIXED_TERM
  PROBATION
  CONTRACTOR
}

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum TalentStatus {
  NOT_ASSESSED
  CORE
  HIGH_POTENTIAL
  TOP_TALENT
  AT_RISK
}

model LookupValue {
  id        String   @id @default(cuid())
  category  String
  value     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([category, value])
  @@index([category])
}

model JobRole {
  id               String          @id @default(cuid())
  title            String
  department       String?
  division         String?
  responsibilities String?
  evaluations      JobEvaluation[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model JobEvaluation {
  id        String  @id @default(cuid())
  jobRoleId String
  jobRole   JobRole @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)

  // Know-How inputs (Hay codes)
  khTech   String
  khFt     String
  khMgmt   String
  khMgmtFt String
  khHr     String

  // Problem Solving inputs
  psTe String
  psTc String
  psFt String @default("")

  // Accountability inputs
  accFta  String
  accMag  String
  accType String
  accFt   String @default("")

  // Computed results
  khPoints    Int
  psPoints    Int
  accPoints   Int
  totalPoints Int
  hayLevel    String
  khNotation  String

  khValidity  String?
  psValidity  String?
  accValidity String?
  notes       String?

  evaluatorId String?
  evaluator   User?   @relation(fields: [evaluatorId], references: [id])

  createdAt DateTime @default(now())
}

enum CriticalPriority {
  IMPERATIVE
  IMPORTANT
  DISCRETIONARY
  NOT_URGENT
}

model Designation {
  id         String    @id @default(cuid())
  title      String
  grade      String?
  holderName String?
  holderId   String?
  holder     Employee? @relation("DesignationHolder", fields: [holderId], references: [id])

  assessments     CriticalAssessment[]
  successProfiles SuccessProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CriticalAssessment {
  id            String      @id @default(cuid())
  designationId String
  designation   Designation @relation(fields: [designationId], references: [id], onDelete: Cascade)

  scores        Int[] // 13 answers, 0-5 each
  sectionScores Int[] // 5 section subtotals, computed at save time
  total         Int
  priority      CriticalPriority

  assessorId String?
  assessor   User?   @relation(fields: [assessorId], references: [id])

  createdAt DateTime @default(now())
}

model SuccessProfile {
  id            String      @id @default(cuid())
  designationId String
  designation   Designation @relation(fields: [designationId], references: [id], onDelete: Cascade)

  position  String? // Succession Position -- the target role, may differ from the Designation's own title
  incumbent String?
  year      String?
  location  String?
  level     String?
  area      String?
  urgency   Int? // 1-5

  // { edu, exp1, exp2, exp3, know, sk1-4, duty1-5 }
  criteria   Json?
  // { leadCur, leadFut, coreCur, coreFut, ei, otherCur, otherFut }
  leadership Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CompensationCalcMethod {
  STANDARD  // input = gross salary, system computes net/insurance/tax
  REVERSE   // input = agreed net basic + allowances, system solves for gross
  NET_BASED // input = agreed net salary; base = net/3 * factor; all extras taxable
}

// DeductionType enum removed — type is now a free-text String sourced from
// LookupValue category COMPENSATION_DEDUCTION_TYPE (admin-configurable).

enum DeductionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AdditionType {
  SIGN_ON_BONUS
  PERFORMANCE_BONUS
  SALARY_ADVANCE
}

// Versioned history per employee, same pattern as JobEvaluation: every save
// inserts a new row, "current" = latest createdAt per employeeId.
model CompensationRecord {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  jobLevel   String? // snapshot of Employee.jobLevel at entry time
  compaRatio Float? // manual entry -- no grade-to-bracket mapping exists yet to auto-derive it

  calcMethod CompensationCalcMethod

  agreedNetBasicSalary Float
  agreedNetAllowances  Float @default(0)
  totalAgreedNetSalary Float // computed: basic + allowances

  socialInsuredSalary          Float
  socialInsuranceEmployeeShare Float
  socialInsuranceCompanyShare  Float
  grossSalary                  Float
  salaryTaxAnnual              Float
  salaryTaxMonthly             Float
  martyrFundDeduction          Float
  totalCostMonthly             Float? // NET_BASED only: total monthly burden on company

  lastCommissionReceivedAmount Float?
  notes                        String?

  enteredById String?
  enteredBy   User?   @relation(fields: [enteredById], references: [id])

  createdAt DateTime @default(now())

  @@index([employeeId])
}

// Covers all 5 deduction types with one shape; installment fields are
// nullable for flat/recurring ones (Premium Card, Money Fellows, Penalty).
model CompensationDeduction {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type String // sourced from LookupValue category COMPENSATION_DEDUCTION_TYPE

  totalAmount     Float? // only meaningful for installment-based types
  numInstallments Int?
  monthlyAmount   Float   // amount per period (label kept for backward compat)
  frequency       String  @default("MONTHLY") // MONTHLY | QUARTERLY | SEMI_ANNUAL | ONE_TIME
  startDate       DateTime
  endDate         DateTime? // null = ongoing / until totalAmount paid off
  status          DeductionStatus @default(ACTIVE)
  notes           String?

  createdAt DateTime @default(now())

  @@index([employeeId])
}

// One-off entries: sign-on bonus, performance bonus, salary advance given.
model CompensationAddition {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type   AdditionType
  amount Float
  date   DateTime
  notes  String?

  createdAt DateTime @default(now())

  @@index([employeeId])
}

// Recurring or one-time extras (allowances, bonuses, etc.) tracked per employee.
// All extras are included in the tax pool under the NET_BASED calc method.
model CompensationExtra {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type        String   // sourced from LookupValue category COMPENSATION_EXTRA_TYPE
  amount      Float    // amount per period (monthly / quarterly / semi-annual)
  frequency   String    // MONTHLY | QUARTERLY | SEMI_ANNUAL | ONE_TIME
  date        DateTime  // effective / start date
  endDate     DateTime? // end date — required for recurring, null for ONE_TIME
  notes       String?

  createdAt DateTime @default(now())

  @@index([employeeId])
}

// Audit log only -- not the file itself. The file is generated on demand
// and streamed to the browser; this row records that it happened.
model BankTransferExport {
  id            String @id @default(cuid())
  periodMonth   Int
  periodYear    Int
  employeeCount Int
  totalAmount   Float

  generatedById String?
  generatedBy   User?   @relation(fields: [generatedById], references: [id])

  createdAt DateTime @default(now())
}

model Employee {
  id           String @id @default(cuid())
  employeeCode String @unique

  // Identity
  firstName     String?
  lastName      String?
  fullName      String
  photoUrl      String?
  businessEmail String  @unique
  personalEmail String?

  // Org placement
  workLocation    String?
  businessUnit    String?
  designation     String?
  division        String?
  function        String?
  functionType    String?
  vertical        String?
  jobLocation     String?
  department      String?
  systemAuthority String?

  // Employment
  contractType        ContractType?
  contractRenewalDate DateTime?
  status              EmploymentStatus @default(ACTIVE)
  sourceOfHiring      String?
  dateOfJoining       DateTime?
  dateOfExit          DateTime?
  reportingManagerId  String?
  reportingManager    Employee?        @relation("ManagerSubordinates", fields: [reportingManagerId], references: [id])
  subordinates        Employee[]       @relation("ManagerSubordinates")

  // Personal
  dateOfBirth                DateTime?
  gender                     Gender?
  maritalStatus              MaritalStatus?
  workPhone                  String?
  personalPhone              String?
  alternativePhone           String?
  presentAddress             String?
  idAddress                  String?
  socialInsuranceNumber      String?
  socialInsuranceStatus      String?
  medicalInsurancePlan       String?
  medicalInsuranceExpiryDate DateTime?
  bankAccountName            String?
  bankAccountNumber          String?
  idNumber                   String?
  idExpiryDate               DateTime?

  // Career (legacy — kept for historical data)
  jobLevel                 String?
  personalLevel            String?
  lastPromotionDate        DateTime?
  previousTitleAtPromotion String?
  lastTransferDate         DateTime?
  previousTitleAtTransfer  String?
  probationScore           Float?
  talentStatus             TalentStatus @default(NOT_ASSESSED)
  lastTalentEvaluationDate DateTime?

  // People Directory additions (Employee Master Log Template)
  // Personal Information
  nationality        String?
  numberOfDependents Int?

  // Contact Information
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?

  // Employment Details
  probationEndDate DateTime?

  // Organizational Data
  legalEntity               String?
  costCenter                String?
  lastPromotionTransferDate DateTime?
  previousDesignation       String?

  // Compensation & Benefits
  socialInsuranceSalary Float?

  // Attendance & Leave
  annualLeaveBalance Float?
  sickLeaveTaken     Float?
  hajjLeaveUsed      Float?

  // Legal & Compliance
  workPermitStatus String?
  contractSigned   Boolean?
  laborLawCategory String?

  // Exit Data
  reasonForLeaving       String?
  endOfServiceSettlement Float?
  rehireEligible         Boolean?

  user   User?   @relation("UserEmployee", fields: [userId], references: [id])
  userId String? @unique

  designationsHeld Designation[] @relation("DesignationHolder")

  compensationRecords    CompensationRecord[]
  compensationDeductions CompensationDeduction[]
  compensationAdditions  CompensationAddition[]
  compensationExtras     CompensationExtra[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
